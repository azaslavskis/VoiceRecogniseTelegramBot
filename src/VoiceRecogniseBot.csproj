<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release builds override this with the tag version (-p:Version=...). -->
    <Version>2.2.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Avoids a runtime dependency on libicu in the Linux packages. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Skip the translated resource folders of dependencies; the app is English only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The web UI is three small files served as they are; no precompressed copies needed. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="NLog" Version="6.1.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="Telegram.Bot" Version="22.10.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web UI is served from wwwroot next to the executable, for "dotnet run" as well as published builds. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
