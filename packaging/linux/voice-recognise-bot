#!/bin/sh
# Launcher installed as /usr/bin/voice-recognise-bot.
#
# As root it manages the system service: it runs as the service user against the service's
# data directory, so "sudo voice-recognise-bot config set --token ..." configures the service.
# As any other user it works on that user's own configuration.
set -eu

APP=/opt/voice-recognise-bot/VoiceRecogniseBot
SERVICE_USER=voicebot
SERVICE_HOME=/var/lib/voice-recognise-bot

# VOICE_RECOGNISEBOT_HOME pointing anywhere else means root deliberately wants another data directory.
DATA_HOME="${VOICE_RECOGNISEBOT_HOME:-$SERVICE_HOME}"

if [ "$(id -u)" -eq 0 ] && [ "${DATA_HOME%/}" = "$SERVICE_HOME" ] && id "$SERVICE_USER" >/dev/null 2>&1; then
    # Files left behind by an older root-run installation, or created by running the program
    # directly as root, would be unreadable for the service user.
    if [ -n "$(find "$SERVICE_HOME" ! -user "$SERVICE_USER" -print -quit 2>/dev/null)" ]; then
        chown -R "$SERVICE_USER:$SERVICE_USER" "$SERVICE_HOME"
    fi

    if [ -r /etc/default/voice-recognise-bot ]; then
        set -a
        . /etc/default/voice-recognise-bot
        set +a
    fi

    export VOICE_RECOGNISEBOT_HOME="$SERVICE_HOME"
    cd "$SERVICE_HOME"
    exec runuser -u "$SERVICE_USER" -- "$APP" "$@"
fi

exec "$APP" "$@"
