[Unit]
Description=Voice Recognise Telegram Bot
Documentation=https://github.com/azaslavskis/VoiceRecogniseTelegramBot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voicebot
Group=voicebot
StateDirectory=voice-recognise-bot
WorkingDirectory=/var/lib/voice-recognise-bot
Environment=VOICE_RECOGNISEBOT_HOME=/var/lib/voice-recognise-bot
EnvironmentFile=-/etc/default/voice-recognise-bot
ExecStart=/opt/voice-recognise-bot/VoiceRecogniseBot run

Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
